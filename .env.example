# Google Sheets Database Configuration
# Leave blank to run in Demo / Local mode with realistic sample data!

# 1. The ID of your Google Sheet (from URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# 2. Your Google Cloud Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 3. Your Google Cloud Service Account Private Key (keep quotes and \n intact)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Custom App Name or Currency symbol
NEXT_PUBLIC_APP_NAME="ClearView Window Cleaning"
NEXT_PUBLIC_CURRENCY_SYMBOL="£"
