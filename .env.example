# ───────────────────────────────────────────────────
# ClearView - Google OAuth Setup
# ───────────────────────────────────────────────────
#
# 1. Go to https://console.cloud.google.com
# 2. Create a project (or pick an existing one)
# 3. Enable "Google Sheets API" and "Google Drive API"
# 4. Go to "APIs & Services > Credentials"
# 5. Create an OAuth 2.0 Client ID (Web Application)
#    - Add your Vercel domain to "Authorized JavaScript origins"
#    - Add <your-domain>/api/auth/callback/google to "Authorized redirect URIs"
# 6. Copy the Client ID and Secret below
#
# That's it — users sign in with their own Google account.
# No service accounts, no billing, nothing else needed.
# ───────────────────────────────────────────────────

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Random secret for session encryption.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Your deployment URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
